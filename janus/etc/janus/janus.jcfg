general: {
	configs_folder = "/etc/janus"
	debug_level = 4
}

media: {
	rtp_port_range = "20000-20100"
}

nat: {
	stun_server = "stun.l.google.com"
	stun_port = 19302
	# Behind NAT, uncomment and set your public IP:
	#nat_1_1_mapping = "1.2.3.4"
}

# Only load the VideoRoom plugin and the HTTP + WebSocket transports.
plugins: {
	disable = "libjanus_audiobridge.so,libjanus_echotest.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_streaming.so,libjanus_textroom.so,libjanus_videocall.so,libjanus_voicemail.so,libjanus_nosip.so,libjanus_duktape.so,libjanus_lua.so"
}

transports: {
	disable = "libjanus_nanomsg.so,libjanus_mqtt.so,libjanus_pfunix.so,libjanus_rabbitmq.so"
}
